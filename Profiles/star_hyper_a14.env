name: Build Kernel • star_hyper_a14

on:
  workflow_dispatch:
    inputs:
      PROFILE_NAME:
        description: "Arquivo de perfil em Profiles/ (ex.: star_hyper_a14.env)"
        required: true
        default: "star_hyper_a14.env"
      PYTHON_VERSION:
        description: "Versão do Python para toolings (2 ou 3)"
        required: true
        default: "3"

jobs:
  build:
    runs-on: ubuntu-22.04

    env:
      TZ: America/Sao_Paulo
      PROFILE_NAME: ${{ inputs.PROFILE_NAME }}
      PYTHON_VERSION: ${{ inputs.PYTHON_VERSION }}

    steps:
      - name: Checkout repositório
        uses: actions/checkout@v4

      - name: Mostrar versões do runner
        run: |
          set -euxo pipefail
          uname -a
          gcc --version || true
          clang --version || true
          python3 --version || true
          git --version

      # ============ CARREGAR PERFIL (robusto) ============
      - name: Carregar perfil
        id: load_env
        shell: bash
        run: |
          set -euo pipefail
          PROFILE="Profiles/${PROFILE_NAME}"
          test -f "${PROFILE}" || { echo "::error::Perfil não encontrado: ${PROFILE}"; exit 2; }
          echo "→ Perfil: ${PROFILE}"

          # 1) Sanitiza (CRLF→LF, tira espaços, ignora comentários/linhas vazias)
          SANITIZED="$(mktemp)"
          sed -E 's/\r$//; s/^[[:space:]]+//; s/[[:space:]]+$//;' "${PROFILE}" \
          | grep -E '^[A-Za-z_][A-Za-z0-9_]*=.*' \
          | sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//' \
          > "${SANITIZED}"

          echo "→ Conteúdo sanitizado do perfil:"
          nl -ba "${SANITIZED}"

          # 2) Faz source exportando as variáveis
          set -a
          # shellcheck disable=SC1090
          . "${SANITIZED}"
          set +a

          # 3) Quais variáveis vamos propagar para o ambiente do job
          VARS=(
            KERNEL_SOURCE KERNEL_BRANCH DEFCONFIG_NAME
            CLANG_SOURCE CLANG_TRIPLE EXTRA_CMDS
            AK3_SOURCE AK3_BRANCH
            KERNELSU_SOURCE KERNELSU_BRANCH KERNELSU_NAME
            ROM_TEXT SUSFS_ENABLE SUSFS_FIXED SUSFS_UPDATE
            BOOT_SOURCE LXC_ENABLE HAVE_NO_DTBO HAVE_NO_DTBO_TOOL
          )
          for v in "${VARS[@]}"; do
            if [[ -n "${!v-}" ]]; then
              printf '%s=%s\n' "$v" "${!v}" >> "$GITHUB_ENV"
            fi
          done

          echo "→ Variáveis chave carregadas:"
          for v in KERNEL_SOURCE KERNEL_BRANCH DEFCONFIG_NAME ROM_TEXT; do
            printf '   %s=%s\n' "$v" "${!v-}"
          done

          # 4) Guard-rails: garanta que o essencial veio do perfil
          : "${KERNEL_SOURCE:?KERNEL_SOURCE não definido no perfil}"
          : "${KERNEL_BRANCH:?KERNEL_BRANCH não definido no perfil}"
          : "${DEFCONFIG_NAME:?DEFCONFIG_NAME não definido no perfil}"

      # ============ LLVM opcional ============
      - name: (Opcional) Baixar LLVM/Clang do perfil
        if: ${{ env.CLANG_SOURCE != '' }}
        run: |
          set -euxo pipefail
          mkdir -p "$GITHUB_WORKSPACE/clang"
          curl -L --retry 3 --retry-delay 3 "$CLANG_SOURCE" -o /tmp/clang.tar.xz
          tar -xJf /tmp/clang.tar.xz -C "$GITHUB_WORKSPACE/clang" --strip-components=1
          echo "$GITHUB_WORKSPACE/clang/bin" >> $GITHUB_PATH
          echo "LLVM=1"        >> $GITHUB_ENV
          echo "LLVM_IAS=1"    >> $GITHUB_ENV
          echo "LD=ld.lld"     >> $GITHUB_ENV

      # ============ Toolchain fallback ============
      - name: Instalar toolchain fallback (se não baixou clang)
        if: ${{ env.CLANG_SOURCE == '' }}
        run: |
          set -euxo pipefail
          sudo apt-get update
          sudo apt-get install -y build-essential bc bison flex libssl-dev \
              libelf-dev ccache python3 python2 curl git rsync lz4 \
              gcc-aarch64-linux-gnu gcc-arm-linux-gnueabi
          echo "CROSS_COMPILE=aarch64-linux-gnu-" >> $GITHUB_ENV
          echo "CROSS_COMPILE_ARM32=arm-linux-gnueabi-" >> $GITHUB_ENV

      # ============ Kernel source ============
      - name: Clonar fonte do Kernel
        run: |
          set -euxo pipefail
          rm -rf device_kernel
          git clone --depth=1 -b "$KERNEL_BRANCH" "$KERNEL_SOURCE" device_kernel
          cd device_kernel
          echo "KERNEL_TREE=$(pwd)" >> $GITHUB_ENV

      # ============ Injetar KernelSU (com SuSFS/Magic) ============
      - name: Injetar KernelSU no tree do kernel
        run: |
          set -euxo pipefail
          cd "$KERNEL_TREE"

          KS_DIR="drivers/kernelsu"
          echo "→ Limpando destino para evitar conflito (arquivo/symlink/dir): $KS_DIR"
          rm -rf "$KS_DIR"
          mkdir -p "$KS_DIR"

          : "${KERNELSU_SOURCE:?KERNELSU_SOURCE não definido}"
          : "${KERNELSU_BRANCH:?KERNELSU_BRANCH não definido}"

          echo "→ Clonando KernelSU: ${KERNELSU_SOURCE} (branch: ${KERNELSU_BRANCH})"
          rm -rf /tmp/KernelSU
          git clone --depth=1 -b "${KERNELSU_BRANCH}" "${KERNELSU_SOURCE}" /tmp/KernelSU

          echo "→ Copiando KernelSU (pasta kernel/*) → $KS_DIR"
          cp -a /tmp/KernelSU/kernel/* "$KS_DIR"/

          # Garante includes no tree
          grep -q 'source "drivers/kernelsu/Kconfig"' drivers/Kconfig || \
            echo 'source "drivers/kernelsu/Kconfig"' >> drivers/Kconfig
          grep -q 'obj-$(CONFIG_KSU)      += kernelsu/' drivers/Makefile || \
            echo 'obj-$(CONFIG_KSU)      += kernelsu/' >> drivers/Makefile

      # ============ Saneamento de textos ============
      - name: Sanear Makefiles/Config (CRLF/BOM/TAB)
        run: |
          set -euxo pipefail
          cd "$KERNEL_TREE"
          find . -type f \( -name "Makefile" -o -name "Kconfig" -o -name "*.mk" -o -name "*.cfg" \) \
            -print0 | xargs -0 sed -i 's/\r$//'

      # ============ Hotfix binder_gki (include com quotes) ============
      - name: Hotfix:binder_gki.c include path (millet)
        run: |
          set -euxo pipefail
          cd "$KERNEL_TREE"
          FILE="drivers/mihw/millet/binder_gki.c"
          if [[ -f "$FILE" ]]; then
            # Ajusta para "android/binder_internal.h" (com aspas)
            sed -i 's|^#include <\.\./\.\./android/binder_internal\.h>|#include "android/binder_internal.h"|' "$FILE" || true
            sed -i 's|^#include <android/binder_internal\.h>|#include "android/binder_internal.h"|' "$FILE" || true
          fi

      # ============ Compilar ============
      - name: Compilar Kernel (defconfig + build)
        run: |
          set -euxo pipefail
          cd "$KERNEL_TREE"
          echo "Usando defconfig: ${DEFCONFIG_NAME}"

          export ARCH=arm64
          export SUBARCH=arm64

          # defconfig
          make -j"$(nproc)" "${DEFCONFIG_NAME}"

          # build
          make -j"$(nproc)" \
            ${LLVM:+LLVM=1} \
            ${LLVM_IAS:+LLVM_IAS=1} \
            ${LD:+LD=$LD} \
            ${CROSS_COMPILE:+CROSS_COMPILE=$CROSS_COMPILE} \
            ${CROSS_COMPILE_ARM32:+CROSS_COMPILE_ARM32=$CROSS_COMPILE_ARM32} \
            ${EXTRA_CMDS:+$EXTRA_CMDS}

          # artefatos de interesse
          mkdir -p "$GITHUB_WORKSPACE/out"
          for f in \
            arch/arm64/boot/Image.gz-dtb \
            arch/arm64/boot/Image.gz \
            arch/arm64/boot/Image \
            out/arch/arm64/boot/Image.gz-dtb \
            out/arch/arm64/boot/Image.gz \
            out/arch/arm64/boot/Image; do
            [[ -f "$f" ]] && cp -av "$f" "$GITHUB_WORKSPACE/out/" || true
          done

      # ============ AnyKernel3 ============
      - name: Empacotar com AnyKernel3
        run: |
          set -euxo pipefail
          cd "$GITHUB_WORKSPACE"
          rm -rf AnyKernel3
          : "${AK3_SOURCE:=https://github.com/osm0sis/AnyKernel3.git}"
          : "${AK3_BRANCH:=master}"
          git clone --depth=1 -b "${AK3_BRANCH}" "${AK3_SOURCE}" AnyKernel3
          cp -av out/* AnyKernel3/ || true
          cd AnyKernel3
          zip -r9 "$GITHUB_WORKSPACE/Kernel-star_hyper_a14-$(date +%Y%m%d-%H%M).zip" ./

      # ============ Artefato ============
      - name: Publicar artefato
        uses: actions/upload-artifact@v4
        with:
          name: Kernel-star_hyper_a14
          path: |
            out/**
            *.zip
