#=====Perfil star_hyper_a14 (HyperOS 14)=====
CONFIG_ENV=Profiles/star_hyper_a14.env

DEVICE_NAME=xiaomi_11_ultra
DEVICE_CODENAME=star

# Toolchain (Clang 19) e flags coerentes
CLANG_SOURCE=https://github.com/llvm/llvm-project/releases/download/llvmorg-19.1.7/LLVM-19.1.7-Linux-X64.tar.xz
CLANG_TRIPLE=aarch64-linux-gnu-
CUSTOM_CMDS=CLANG_TRIPLE=aarch64-linux-gnu-
EXTRA_CMDS=LD=ld.lld LLVM=1 LLVM_IAS=1

# Fonte do kernel
KERNEL_SOURCE=https://github.com/EndCredits/android_kernel_xiaomi_sm8350-miui.git
KERNEL_BRANCH=hyper-14

# Defconfig do aparelho
DEFCONFIG_NAME=vendor/star_defconfig

# AnyKernel3 para empacotar
AK3_SOURCE=https://github.com/osm0sis/AnyKernel3.git
AK3_BRANCH=master

#=====KernelSU com SuSFS=====
# Fork que contém SuSFS integrado ao KernelSU
# (se preferir, pode testar SukiSU-Ultra abaixo — comente um e descomente o outro)
KERNELSU_SOURCE=https://github.com/rsuntk/KernelSU.git
KERNELSU_BRANCH=susfs-main
KERNELSU_NAME=KernelSU

# Alternativa:
# KERNELSU_SOURCE=https://github.com/ShirkNeko/SukiSU-Ultra.git
# KERNELSU_BRANCH=susfs-main

# Flags de controle (não quebram nada se o pipeline ainda não usa)
SUSFS_ENABLE=true
SUSFS_FIXED=true
SUSFS_UPDATE=true

# (opcional) imagem de boot de referência
BOOT_SOURCE=https://github.com/boot_author/android_kernel_codename/raw/refs/heads/main/rom/source_imgs/boot.img

# Outros toggles
LXC_ENABLE=false
HAVE_NO_DTBO=false
HAVE_NO_DTBO_TOOL=false

# Info de ROM (usada só para rótulos/log)
ROM_TEXT=hyperos_android14
