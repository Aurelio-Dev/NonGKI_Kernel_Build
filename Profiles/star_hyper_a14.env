# Fonte do kernel
KERNEL_SOURCE=https://github.com/EndCredits/android_kernel_xiaomi_sm8350-miui
KERNEL_BRANCH=a14-miui
DEFCONFIG_NAME=vendor/star_hyper_a14_defconfig

# (Opcional) LLVM/Clang pré-compilado (deixe vazio para usar apt)
CLANG_SOURCE=

# AnyKernel3
AK3_SOURCE=https://github.com/osm0sis/AnyKernel3.git
AK3_BRANCH=master

# KernelSU
KERNELSU_SOURCE=https://github.com/tiann/KernelSU.git
KERNELSU_BRANCH=main
KERNELSU_NAME=KernelSU

# Texto/identificadores (apenas para logs)
ROM_TEXT=hyperos_android14

# Flags opcionais (deixe vazio se não usar)
SUSFS_ENABLE=
SUSFS_FIXED=
SUSFS_UPDATE=
BOOT_SOURCE=
LXC_ENABLE=
HAVE_NO_DTBO=
HAVE_NO_DTBO_TOOL=
EXTRA_CMDS=
