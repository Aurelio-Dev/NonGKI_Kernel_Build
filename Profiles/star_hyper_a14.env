# ===== Perfil star_hyper_a14 (HyperOS 14) =====
CONFIG_ENV=Profiles/star_hyper_a14.env

# Dispositivo
DEVICE_NAME=xiaomi_11_ultra
DEVICE_CODENAME=star

# ------- Toolchain (Clang 19) -------
# Baixa e injeta no PATH; o workflow usa LLVM=1/LD=ld.lld quando CLANG_SOURCE está setado
CLANG_SOURCE=https://github.com/llvm/llvm-project/releases/download/llvmorg-19.1.7/LLVM-19.1.7-Linux-X64.tar.xz
# Triple padrão para targets arm64 caso o build caia no fallback/GCC
CLANG_TRIPLE=aarch64-linux-gnu-
# Flags extras para o build com Clang (o workflow lê e exporta quando presentes)
EXTRA_CMDS=LD=ld.lld LLVM=1 LLVM_IAS=1

# ------- Fonte do kernel -------
KERNEL_SOURCE=https://github.com/EndCredits/android_kernel_xiaomi_sm8350-miui.git
KERNEL_BRANCH=hyper-14

# Defconfig
DEFCONFIG_NAME=vendor/star_defconfig

# ------- AnyKernel3 para empacotar -------
AK3_SOURCE=https://github.com/osm0sis/AnyKernel3.git
AK3_BRANCH=master

# ------- KernelSU + SuSFS -------
# (a) Se você já tiver SuSFS aplicado no kernel, mantenha estes dois:
# KERNELSU_SOURCE=https://github.com/rsuntk/KernelSU.git
# KERNELSU_BRANCH=susfs-main

# (b) Caso contrário, deixe o Magic (compila em qualquer kernel):
KERNELSU_SOURCE=https://github.com/backslashxx/KernelSU.git
KERNELSU_BRANCH=master

# Caso queira testar KernelSU-Next com SuSFS, troque para um fork que leve SuSFS já portado
# (ex.: rsuntk/KernelSU na branch next-susfs, se/ quando existir):
# KERNELSU_SOURCE=https://github.com/rsuntk/KernelSU.git
# KERNELSU_BRANCH=next-susfs
# KERNELSU_NAME=KernelSU-Next

# Toggles que o workflow pode usar para rótulos/decisões (não quebram se não forem lidos)
SUSFS_ENABLE=true
SUSFS_FIXED=true
SUSFS_UPDATE=true

# ------- (opcional) imagem de boot de referência -------
# Deixe vazio se não usar
BOOT_SOURCE=

# ------- Outros toggles -------
LXC_ENABLE=false
HAVE_NO_DTBO=false
HAVE_NO_DTBO_TOOL=false

# Info de ROM (usada só para rótulos/log)
ROM_TEXT=hyperos_android14
